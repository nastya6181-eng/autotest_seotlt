# Скопируй в .env (он в .gitignore) — run_checks.py прочитает его сам.
# Переменные окружения важнее значений из .env.

# Все сайты для прогона: по одному на строку, «ключ=https://адрес» или просто адрес.
# Если домен совпадает с url в projects/<ключ>/project.yml, берутся настройки проекта.
SITES="
innotech=https://inno.seotlt.ru/
lazun=https://lazun.com/
"

# Прогнать только один сайт: ключ из SITES или любой адрес. Пусто — все.
SITE=

# Лимит страниц (пусто — из project.yml или 200)
MAX_PAGES=

# Только эти проверки: spelling,typography,links (пусто — все)
CHECKS=
