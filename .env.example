# Скопируй в .env (он в .gitignore) — run_checks.py прочитает его сам.
# Переменные окружения важнее значений из .env. Реальные адреса сюда не коммить.

# Один сайт — одна переменная SITE_<КЛЮЧ>: «https://адрес [опция=значение ...]».
# Ключ — суффикс имени в нижнем регистре, «_» → «-»: SITE_SITE_A → site-a.
# Опции: max_pages, delay, max_rps, cooldown, ignore_robots, exclude, workers.
# В GitHub каждая такая переменная — отдельный секрет репозитория с тем же именем.
SITE_SITE_A=https://example.ru/ max_pages=300
SITE_SITE_B="https://example.com/ max_pages=150 max_rps=0.8 cooldown=330"

# Прогнать только один сайт: ключ или любой адрес. Пусто — все.
SITE=

# Лимит страниц (пусто — из настроек сайта или 200)
MAX_PAGES=

# Не чаще N запросов в секунду к сайту
MAX_RPS=

# Только эти проверки: tech,seo,links,spelling,typography (пусто — все)
CHECKS=
